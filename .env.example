# Required for online AI on a deployed ProcessLens instance.
GEMINI_API_KEY=

# Optional free-plan backup AI provider.
GROQ_API_KEY=

# Added automatically by Vercel when a private Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Local server only. Vercel entrypoint forces public mode itself.
PROCESSLENS_PUBLIC=1

# Local troubleshooting only. Leave disabled in production.
PROCESSLENS_DEBUG_ERRORS=0
